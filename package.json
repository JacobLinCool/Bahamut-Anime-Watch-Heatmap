{
  "name": "ani-gamer-heatmap",
  "version": "0.3.1",
  "description": "A browser extension for Bahamut Anime watch heatmaps, seasonal analysis, and personal recaps.",
  "type": "module",
  "private": true,
  "scripts": {
    "assets:store": "node scripts/create-icons.mjs && node scripts/prepare-store-assets.mjs",
    "build": "vite build && vite build --config vite.background.config.ts",
    "harness:dev": "vite .render-harness --port 4173 --strictPort",
    "harness:capture": "node .render-harness/capture.mjs",
    "harness:shoot": "node .render-harness/shoot.mjs",
    "harness:motion": "node .render-harness/motion.mjs",
    "package": "pnpm typecheck && pnpm test && pnpm build && node scripts/package-extension.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "ani-gamer",
    "analytics",
    "browser-extension",
    "heatmap",
    "personal-recap",
    "typescript"
  ],
  "author": "JacobLinCool <jacoblincool@gmail.com> (https://github.com/JacobLinCool)",
  "license": "MIT",
  "packageManager": "pnpm@10.21.0",
  "devDependencies": {
    "@types/chrome": "^0.0.326",
    "@types/node": "^25.0.3",
    "playwright": "^1.61.1",
    "typescript": "^5.9.3",
    "vite": "^7.2.7",
    "vitest": "^4.1.0"
  }
}
