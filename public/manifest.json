{
  "manifest_version": 3,
  "name": "Bahamut Anime Watch Heatmap",
  "description": "Adds a yearly watch history heatmap to Bahamut Anime.",
  "version": "0.1.0",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://ani.gamer.com.tw/*"],
      "js": ["assets/content.js"],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": ["https://ani.gamer.com.tw/*"]
}
