{
  "manifest_version": 3,
  "name": "Bahamut Anime Watch Heatmap",
  "description": "Adds a watch heatmap, seasonal analysis, and personal recaps to Bahamut Anime.",
  "version": "0.3.1",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["storage"],
  "host_permissions": ["https://api.gamer.com.tw/*"],
  "background": {
    "service_worker": "assets/background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://ani.gamer.com.tw/*"],
      "js": ["assets/content.js"],
      "run_at": "document_idle"
    }
  ]
}
